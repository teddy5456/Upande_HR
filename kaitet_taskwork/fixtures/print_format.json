  "html": "<style>\r\n    body {\r\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif;\r\n        font-size: 11px;\r\n        color: #111;\r\n        line-height: 1.4;\r\n    }\r\n\r\n    .title {\r\n        font-size: 15px;\r\n        font-weight: 600;\r\n        margin-bottom: 14px;\r\n    }\r\n\r\n    .summary {\r\n        margin-bottom: 14px;\r\n        border-top: 1px solid #ddd;\r\n        border-bottom: 1px solid #ddd;\r\n        padding: 8px 0;\r\n    }\r\n\r\n    .summary-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        font-size: 11px;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 12px;\r\n    }\r\n\r\n    th {\r\n        border-top: 1px solid #000;\r\n        border-bottom: 1px solid #000;\r\n        padding: 6px;\r\n        font-weight: 600;\r\n        text-align: left;\r\n        font-size: 11px;\r\n    }\r\n\r\n    td {\r\n        border-bottom: 1px solid #e5e5e5;\r\n        padding: 6px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .right {\r\n        text-align: right;\r\n    }\r\n</style>\r\n\r\n<div class=\"title\">\r\n    <div style=\"max-width:400px; padding:0px\">{{letter_head}}</div>\r\n    Payment Instruction – Weekly Disbursement\r\n</div>\r\n\r\n<div class=\"summary\">\r\n    <div class=\"summary-row\">\r\n        <div><strong>Total Beneficiaries:</strong> {{ doc.total_employees }}</div>\r\n        <div>\r\n            <strong>Total Amount:</strong>\r\n            {{ frappe.format(doc.total_amount, {\"fieldtype\": \"Currency\"}) }}\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<table>\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width:4%;\">No.</th>\r\n            <th style=\"width:22%;\">Beneficiary Name</th>\r\n            <th style=\"width:20%;\">Debit Account</th>\r\n            <th style=\"width:22%;\">Account Number</th>\r\n            <th style=\"width:20%;\" class=\"right\">Amount</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for row in doc.disbursement_table %}\r\n        <tr>\r\n            <td>{{ loop.index }}</td>\r\n            <td>{{ row.employee_name }}</td>\r\n            <td>1310262053257</td>\r\n            <td>{{ row.bank_account_no }}</td>\r\n            <td class=\"right\">\r\n                {{ frappe.format(row.total_amount, {\"fieldtype\": \"Currency\"}) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n",
