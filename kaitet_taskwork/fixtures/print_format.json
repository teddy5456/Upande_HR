  "format_data": null,
  "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap');\n\n    .print-wrapper {\n        font-family: 'DM Sans', sans-serif;\n        color: #000;\n        padding: 20px;\n        background: #ffffff;\n    }\n\n    .letterhead-container {\n        margin-bottom: 40px;\n        padding-bottom: 20px;\n        width:150px;\n        background: transparent;\n    }\n\n    .meta-header {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 40px;\n        padding-bottom: 20px;\n    }\n\n    .meta-title {\n        font-size: 10px;\n        text-transform: uppercase;\n        letter-spacing: 0.8px;\n        color: #4b5563;\n        margin-bottom: 4px;\n        font-weight: 500;\n        background:#fff;\n    }\n\n    .meta-val {\n        font-size: 15px;\n        font-weight: 700;\n        color: #000000;\n    }\n\n    .worker-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 20px;\n    }\n\n    .worker-table th {\n        text-align: left;\n        padding: 10px 8px;\n        border-top: 1px solid #d1d5db;\n        border-bottom: 1px solid #d1d5db;\n        font-size: 10px;\n        text-transform: uppercase;\n        letter-spacing: 0.6px;\n        font-weight: 600;\n        background:#fff;\n        color: #000000;\n    }\n\n    .worker-table td {\n        padding: 12px 8px;\n        border-left: 1px solid #e5e7eb;\n        border-right: 1px solid #e5e7eb;\n        border-bottom: 1px solid #e5e7eb;\n        font-size: 12px;\n        color: #000000;\n        font-weight: 400;\n        background: #ffffff;\n    }\n\n    .worker-table td:first-child {\n        font-weight: 500;\n        color: #000000;\n    }\n\n    @media print {\n        body {\n            background: white;\n            padding: 0;\n            margin: 0;\n        }\n        .print-wrapper {\n            box-shadow: none;\n            padding: 0.2in;\n        }\n    }\n</style>\n\n<div class=\"print-wrapper\">\n    <div class=\"letterhead-container\">\n        {{ letter_head }}\n    </div>\n\n    <div class=\"meta-header\">\n        <div>\n            <div class=\"meta-title\">Request Reference</div>\n            <div class=\"meta-val\">{{ doc.name }}</div>\n        </div>\n        <div style=\"text-align: right;\">\n            <div class=\"meta-title\">Week / Location</div>\n            <div class=\"meta-val\">{{ doc.custom_week }} / {{ doc.custom_location }}</div>\n        </div>\n    </div>\n\n    <table class=\"worker-table\">\n        <thead>\n            <tr>\n                <th>Worker Name</th>\n                <th>Employee ID</th>\n                <th>Assigned Task</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for emp in doc.suggested_employees %}\n            <tr>\n                <td style=\"font-weight: 500;\">{{ emp.worker_name }}</td>\n                <td>{{ emp.task_worker }}</td>\n                <td>{{ emp.task }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>",
